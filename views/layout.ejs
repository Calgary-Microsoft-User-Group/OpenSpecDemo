<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== "undefined" && title ? `${title} — ${shop.name}` : shop.name %></title>
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="site-header__inner">
      <a class="site-header__brand" href="/"><%= shop.name %></a>
      <nav class="site-nav" aria-label="Main">
        <a href="/">Home</a>
        <a href="/menu">Menu</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <%- body %>
  </main>

  <footer class="site-footer">
    <p class="allergen-notice">All cookies are made in a kitchen that handles wheat, peanuts, tree nuts, milk, egg, and soy.</p>
    <p class="site-footer__copyright">&copy; <%= new Date().getFullYear() %> <%= shop.name %></p>
  </footer>
</body>
</html>
